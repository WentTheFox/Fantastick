// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model DiscordUser {
  id              BigInt    @id
  name            String    @db.VarChar(32)
  displayName     String?   @db.VarChar(255)
  discriminator   String    @db.Char(4)
  avatar          String?   @db.VarChar(64)
  readOnly        Boolean   @default(true)
  packs           Pack[]      @relation("CreatedPacks")
  deletedPacks    Pack[]      @relation("DeletedPacks") @ignore
  stickers        Sticker[]   @relation("CreatedStickers")
  deletedStickers Sticker[]   @relation("DeletedStickers") @ignore
  importJobs      ImportJob[] @relation("ImportedJobs")
}

model TelegramPack {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramPackName String            @db.VarChar(255)
  title            String
  lastImportedAt   DateTime?         @db.Timestamptz(0)
  createdAt        DateTime          @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime?         @updatedAt @db.Timestamptz(0)
  stickers         TelegramSticker[]
  packs            Pack[]

  @@unique([telegramPackName])
}

model TelegramSticker {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  telegramPack         TelegramPack @relation(fields: [telegramPackId], references: [id])
  telegramPackId       String       @db.Uuid
  telegramFileUniqueId String       @db.VarChar(255)
  emoji                String
  order                Int          @default(0)
  url                  String       @db.VarChar(255)
  createdAt            DateTime     @default(now()) @db.Timestamptz(0)
  updatedAt            DateTime?    @updatedAt @db.Timestamptz(0)
  deletedAt            DateTime?    @db.Timestamptz(0)
  stickers             Sticker[]

  @@unique([telegramPackId, telegramFileUniqueId])
  @@index([deletedAt])
}

model Pack {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  stickers       Sticker[]
  importJobs     ImportJob[]
  createdBy      BigInt
  creator        DiscordUser   @relation("CreatedPacks", fields: [createdBy], references: [id])
  createdAt      DateTime      @default(now()) @db.Timestamptz(0)
  updatedAt      DateTime?     @updatedAt @db.Timestamptz(0)
  deletedAt      DateTime?     @db.Timestamptz(0)
  deletedBy      BigInt?
  deleter        DiscordUser?  @relation("DeletedPacks", fields: [deletedBy], references: [id])
  nsfw           Boolean       @default(false)
  public         Boolean       @default(false)
  telegramPack   TelegramPack? @relation(fields: [telegramPackId], references: [id])
  telegramPackId String?       @db.Uuid

  @@index([name])
  @@index([deletedAt])
  @@index([telegramPackId])
}

model Sticker {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack              Pack             @relation(fields: [packId], references: [id])
  packId            String           @db.Uuid
  name              String
  description       String?          @db.VarChar(255)
  url               String?          @db.VarChar(255)
  createdBy         BigInt
  creator           DiscordUser      @relation("CreatedStickers", fields: [createdBy], references: [id])
  createdAt         DateTime         @default(now()) @db.Timestamptz(0)
  updatedAt         DateTime?        @updatedAt @db.Timestamptz(0)
  deletedAt         DateTime?        @db.Timestamptz(0)
  deletedBy         BigInt?
  deleter           DiscordUser?     @relation("DeletedStickers", fields: [deletedBy], references: [id])
  order             Int              @default(0)
  telegramSticker   TelegramSticker? @relation(fields: [telegramStickerId], references: [id])
  telegramStickerId String?          @db.Uuid
  // Tri-state rating override: null = inherit Pack.nsfw, false = force SFW, true = force NSFW
  nsfwOverride      Boolean?
  stickerMessages   StickerMessage[] @ignore

  @@index([deletedAt])
  @@index([name])
  @@index([telegramStickerId])
}

enum ImportJobStatus {
  PENDING
  FETCHING
  IMPORTING
  FINALIZING
  COMPLETED
  FAILED
  ROLLING_BACK
}

model ImportJob {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack             Pack            @relation(fields: [packId], references: [id])
  packId           String          @db.Uuid
  importedBy       BigInt
  importer         DiscordUser     @relation("ImportedJobs", fields: [importedBy], references: [id])
  status           ImportJobStatus @default(PENDING)
  total            Int             @default(0)
  completed        Int             @default(0)
  failed           Int             @default(0)
  telegramPackName String          @db.VarChar(255)
  interactionId    String?         @db.VarChar(255)
  interactionToken String?         @db.VarChar(255)
  createdAt        DateTime        @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime?       @updatedAt @db.Timestamptz(0)
  completedAt      DateTime?       @db.Timestamptz(0)
  errorMessage     String?

  @@index([status])
  @@index([packId])
}

model StickerMessage {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId        BigInt
  serverId         BigInt?
  channelId        BigInt?
  stickerId        String    @db.Uuid
  sticker          Sticker   @relation(fields: [stickerId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  createdAt        DateTime  @default(now()) @db.Timestamptz(0)
  updatedAt        DateTime? @updatedAt @db.Timestamptz(0)
  deletedAt        DateTime? @db.Timestamptz(0)
  isFeed           Boolean   @default(false)
  interactionId    String?   @db.VarChar(255)
  interactionToken String?   @db.VarChar(255)

  @@unique([messageId, stickerId])
  @@index([deletedAt])
  @@index([isFeed])
  @@index([channelId])
}
