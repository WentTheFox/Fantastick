{
  "name": "@went.tf/fantastick",
  "version": "1.0.0",
  "description": "Discord app for managing custom stickers using slash commands",
  "author": "WentTheFox <mail@went.tf> (https://github.com/WentTheFox)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf build",
    "start:app": "node --enable-source-maps ./build/src/index.js",
    "start:queue": "node --enable-source-maps ./build/src/queue-worker.js",
    "start": "concurrently -p name npm:start:*",
    "dev:app": "tsx src/index.ts",
    "dev:queue": "pnpm run build && pnpm run start:queue",
    "dev": "concurrently -p name npm:dev:*",
    "lint": "eslint \"{src,utils,scripts}/**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "commitlint": "commitlint --edit",
    "prepare": "ts-patch install && husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@went.tf/discord-bot-framework": "^2.0.0",
    "ajv": "^8.20.0",
    "bufferutil": "^4.1.0",
    "date-fns": "^4.4.0",
    "discord-api-types": "^0.38.49",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "i18next": "^25.10.10",
    "i18next-fs-backend": "^2.6.6",
    "js-levenshtein": "^1.1.6",
    "lottie-web": "^5.13.0",
    "pg": "^8.22.0",
    "pg-boss": "^12.25.1",
    "pm2": "^7.0.3",
    "puppeteer-core": "^25.3.0",
    "rimraf": "^6.1.3",
    "shell-escape": "^0.2.0",
    "string-progressbar": "^1.0.4",
    "tslib": "^2.8.1",
    "utf-8-validate": "^6.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/shell-escape": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "concurrently": "^9.2.3",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18n-validator": "^0.1.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "rollup": "^4.62.2",
    "ts-patch": "^3.3.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typia": "^12.1.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "nodemonConfig": {
    "delay": 1000
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.5.3"
}
