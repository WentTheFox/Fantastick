{
  "name": "@wentthefox/fantastick",
  "version": "1.0.0",
  "description": "Discord app for managing custom stickers using slash commands",
  "author": "WentTheFox <mail@went.tf> (https://github.com/WentTheFox)",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:clean": "rimraf build",
    "start:app": "node --enable-source-maps ./build/src/index.js",
    "start:queue": "node --enable-source-maps ./build/src/queue-worker.js",
    "start": "concurrently -p name npm:start:*",
    "start-dev": "npm run build:clean && npm run build && npm run start",
    "lint": "eslint \"{src,utils}/**/*.ts\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "commitlint": "commitlint --edit",
    "prepare": "ts-patch install && husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@discordjs/formatters": "^0.6.2",
    "@discordjs/rest": "^2.6.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bufferutil": "^4.1.0",
    "date-fns": "^4.4.0",
    "discord-api-types": "^0.38.48",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "i18next": "^25.10.10",
    "i18next-fs-backend": "^2.6.6",
    "js-levenshtein": "^1.1.6",
    "pg": "^8.21.0",
    "pg-boss": "^12.19.1",
    "pm2": "^6.0.14",
    "rimraf": "^6.1.3",
    "shell-escape": "^0.2.0",
    "string-progressbar": "^1.0.4",
    "tslib": "^2.8.1",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "@types/shell-escape": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-i18n-validator": "^0.1.4",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "rollup": "^4.62.0",
    "ts-patch": "^3.3.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typia": "^12.1.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "nodemonConfig": {
    "delay": 1000
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.5.3"
}
